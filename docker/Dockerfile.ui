FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/desktop/ui/package.json apps/desktop/ui/package.json
RUN pnpm install --frozen-lockfile --filter ./apps/desktop/ui...

COPY apps/desktop/ui apps/desktop/ui
RUN pnpm --dir apps/desktop/ui build

FROM nginx:alpine

RUN addgroup -S -g 1000 zeapp \
    && adduser -S -D -H -u 1000 -G zeapp zeapp \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p \
        /tmp/nginx/client_temp \
        /tmp/nginx/proxy_temp \
        /tmp/nginx/fastcgi_temp \
        /tmp/nginx/uwsgi_temp \
        /tmp/nginx/scgi_temp \
    && chown -R 1000:1000 /tmp/nginx /etc/nginx /usr/share/nginx/html

COPY --from=builder --chown=1000:1000 \
    /workspace/apps/desktop/ui/dist \
    /usr/share/nginx/html
COPY --chown=1000:1000 docker/nginx.ui.conf /etc/nginx/nginx.conf

USER 1000:1000

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:5173/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
